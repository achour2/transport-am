# Copier en .env puis remplir. Vide = mode développement (SQLite, courriels en console, paiement simulé)
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=transbagages.example,www.transbagages.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://transbagages.example
SITE_URL=https://transbagages.example

POSTGRES_DB=transbagages
POSTGRES_USER=transbagages
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost

# Brevo : smtp-relay.brevo.com / SendGrid : smtp.sendgrid.net (user "apikey")
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TransBagages <no-reply@transbagages.example>

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

REDIS_URL=redis://localhost:6379/0

# S3_BUCKET=
# S3_ENDPOINT_URL=https://s3.bhs.io.cloud.ovh.net
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=bhs
