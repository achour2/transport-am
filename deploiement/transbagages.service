# /etc/systemd/system/transbagages.service
[Unit]
Description=TransBagages (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
WorkingDirectory=/srv/transbagages
ExecStart=/srv/transbagages/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
