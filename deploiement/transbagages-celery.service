# /etc/systemd/system/transbagages-celery.service — worker + beat (rappels toutes les 2 h, alertes 4 h)
[Unit]
Description=TransBagages (Celery worker + beat)
After=network.target redis-server.service

[Service]
User=www-data
WorkingDirectory=/srv/transbagages
ExecStart=/srv/transbagages/.venv/bin/celery -A config worker --beat --loglevel=info
Restart=always

[Install]
WantedBy=multi-user.target
